SECRET_KEY=change-me-to-a-long-random-string

# ORCID OAuth credentials
# Register your app at: https://orcid.org/developer-tools
# For development use the sandbox: https://sandbox.orcid.org/developer-tools
ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
ORCID_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Callback URL must match exactly what you registered with ORCID
ORCID_REDIRECT_URI=http://localhost:5000/auth/callback

# Switch to production URLs when deploying:
# ORCID_BASE_URL=https://orcid.org
# ORCID_API_URL=https://pub.orcid.org
ORCID_BASE_URL=https://sandbox.orcid.org
ORCID_API_URL=https://pub.sandbox.orcid.org

# OpenAI API key — used for the "Suggest with AI" feature in the survey builder
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# SQLite (default, no setup needed)
DATABASE_URL=sqlite:///conjoint.db
